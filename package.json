{
  "name": "cos-harness",
  "productName": "COS Harness",
  "desktopName": "COS Harness",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "author": "YinshawnRao",
  "description": "腾讯云 COS / 数据万象桌面控制台",
  "scripts": {
    "desktop": "electron .",
    "desktop:preview": "pnpm build && node scripts/prepare-desktop.mjs && electron . --prod",
    "desktop:pack": "pnpm build && node scripts/prepare-desktop.mjs && electron-builder --publish never",
    "desktop:pack:linux": "pnpm build && node scripts/prepare-desktop.mjs && electron-builder --linux AppImage dir --publish never",
    "desktop:pack:mac": "pnpm build && node scripts/prepare-desktop.mjs && electron-builder --mac --publish never",
    "desktop:pack:win": "pnpm build && node scripts/prepare-desktop.mjs && electron-builder --win --publish never",
    "dev": "next dev --hostname 127.0.0.1 --port 47821",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 47821",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/react": "^4.0.82",
    "@base-ui/react": "^1.7.0",
    "ai": "^7.0.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "qcloud-cos-sts": "^3.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.3"
}
